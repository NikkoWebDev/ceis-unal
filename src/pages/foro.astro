---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const posts = [
  {
    estado: 'Resuelta',
    tema: 'Duda académica',
    respuestas: 5,
    fecha: '10 de sept de 2026',
    titulo: 'Como cancelo semestre',
    cuerpo: 'Me equivo de carrera, la universidad en las películas no son así, quién en Jason y PQ lo debo traer',
    autor: 'Jo_aleph_0',
    nombre: 'Joan Sebastian Rivera Barajas',
    color: '#18514A',
  },
  {
    estado: 'Abierta',
    tema: 'Otro',
    respuestas: 1,
    fecha: '10 de sept de 2026',
    titulo: 'Reporten bugs porfavor',
    cuerpo: 'test porque carajos tengo que poner 20 letras para una descripcion',
    autor: 'Ansukic',
    nombre: 'Luis Alejandro Sanchez Moreno',
    color: '#2E5E8C',
  },
  {
    estado: 'Abierta',
    tema: 'Otro',
    respuestas: 6,
    fecha: '10 de sept de 2026',
    titulo: '¿Cuándo cumplen años?',
    cuerpo: 'Para lanzarles huevos y harina (no volvemos a intentar hacer celebraciones sorpresa, porfa y gracias)',
    autor: 'CCarito',
    nombre: 'Carolina Ramirez Hernandez',
    color: '#B8860B',
  },
  {
    estado: 'Abierta',
    tema: 'Otro',
    respuestas: 7,
    fecha: '10 de sept de 2026',
    titulo: '¿Deberian quitar FEM de la malla? Solo razones serias o funa',
    cuerpo: '¿Estamos cada día siendo menos Ingeniería?¿Algún día tendremos facultad de Computación?',
    autor: 'CCarito',
    nombre: 'Carolina Ramirez Hernandez',
    color: '#B8860B',
  },
  {
    estado: 'Abierta',
    tema: 'Otro',
    respuestas: 2,
    fecha: '10 de sept de 2026',
    titulo: 'Fue realmente justo/beneficioso el nuevo método de inscripción',
    cuerpo: 'Pese a mitigar en algo el efecto mateo y contrariar en algo ver electivas fáciles consideran que es bueno para personas con mayor avance que dejaron materias atrás y por tanto tienen una peor inscripción',
    autor: 'Jo_aleph_0',
    nombre: 'Joan Sebastian Rivera Barajas',
    color: '#18514A',
  },
  {
    estado: 'Abierta',
    tema: 'Otro',
    respuestas: 5,
    fecha: '10 de sept de 2026',
    titulo: 'Confiesen quienes se van a lanzar para repres',
    cuerpo: 'Pros y contras de ser repres, repre Daniel cuentanos el lado oscuro de la representación',
    autor: 'CCarito',
    nombre: 'Carolina Ramirez Hernandez',
    color: '#B8860B',
  },
  {
    estado: 'Abierta',
    tema: 'Otro',
    respuestas: 4,
    fecha: '10 de sept de 2026',
    titulo: 'Decanatura de ingeniería',
    cuerpo: 'Charlemos sobre los candidatos, ¿qué propuestas gustan?¿cuáles no agradan?¿el CSU respetará la consulta?¿tenemos esperanza?',
    autor: 'CCarito',
    nombre: 'Carolina Ramirez Hernandez',
    color: '#B8860B',
  },
  {
