---
---

<section class="relative min-h-[100svh] flex items-center overflow-hidden pt-24 pb-16" style="background: linear-gradient(160deg, var(--color-unal) 0%, #0E2A26 55%, var(--color-noche) 100%)">
  <!-- blobs glass -->
  <div class="blob w-[480px] h-[480px] -left-40 top-10" style="background: var(--color-unal-verde); opacity: 0.25" aria-hidden="true"></div>
  <div class="blob w-[420px] h-[420px] right-[-120px] top-1/3" style="background: var(--color-unal-claro); opacity: 0.3; animation-delay: -6s" aria-hidden="true"></div>
  <div class="blob w-[380px] h-[380px] left-1/3 -bottom-32" style="background: var(--color-dorado); opacity: 0.16; animation-delay: -10s" aria-hidden="true"></div>

  <!-- trama -->
  <svg class="absolute inset-0 w-full h-full opacity-[0.06]" aria-hidden="true">
    <defs>
      <pattern id="trama" width="48" height="48" patternUnits="userSpaceOnUse">
        <path d="M48 0H0v48" fill="none" stroke="#F6EEE8" stroke-width="0.5"/>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#trama)"/>
  </svg>

  <div class="relative max-w-[1120px] mx-auto px-5 md:px-7 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-[1.15fr_0.85fr] gap-12 items-center">
      <div>
        <span class="reveal inline-flex items-center gap-2 font-sans text-[13px] tracking-wide rounded-full px-4 py-1.5 mb-8"
          style="color: var(--color-unal-verde); background: rgba(130,180,117,0.12); border: 1px solid rgba(130,180,117,0.35); backdrop-filter: blur(8px)">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2zM22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          Facultad de Ingeniería, Universidad Nacional de Colombia
        </span>

        <p class="reveal font-sans text-sm tracking-[0.3em] uppercase mb-4" style="color: rgba(246,238,232,0.5)">Sede Bogotá — Est. 2024</p>

        <h1 class="reveal font-serif text-[2.7rem] md:text-6xl lg:text-[4.2rem] leading-[1.04] tracking-tight max-w-[15ch]" style="color: var(--color-papel)">
          Consejo Estudiantil de <em class="texto-grad" style="font-style: italic">Ingeniería</em> de Sistemas
        </h1>

        <p class="reveal font-serif text-lg md:text-xl mt-7 max-w-[52ch] leading-relaxed" style="color: rgba(246,238,232,0.82)">
          Un espacio de construcción estudiantil — de estudiantes, por y para estudiantes — donde tejemos representación, soluciones y apoyo mutuo en Ingeniería de Sistemas.
        </p>

        <div class="reveal flex flex-wrap gap-4 mt-10 font-sans">
          <a href="/malla/" class="inline-flex items-center gap-2 text-sm font-semibold px-6 py-3 rounded-2xl transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_16px_40px_rgba(130,180,117,0.35)]"
            style="background: linear-gradient(135deg, var(--color-unal-verde), var(--color-unal-claro)); color: #0E1F1B">
            Ver Malla Curricular
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
          </a>
          <a href="#quienes-somos" class="inline-flex items-center gap-2 text-sm font-semibold px-6 py-3 rounded-2xl transition-all duration-300 hover:-translate-y-1"
            style="background: rgba(246,238,232,0.1); border: 1px solid rgba(246,238,232,0.3); color: var(--color-papel); backdrop-filter: blur(8px)">
            Conócenos
          </a>
        </div>
      </div>

      <!-- tarjeta glass con stats -->
      <div class="reveal hidden lg:block">
        <div class="glass rounded-3xl p-8" style="background: rgba(246,238,232,0.07); border-color: rgba(246,238,232,0.16); box-shadow: 0 24px 64px rgba(0,0,0,0.35)">
          <p class="font-sans text-[11px] font-semibold tracking-[0.25em] uppercase mb-6" style="color: rgba(246,238,232,0.55)">La carrera en cifras</p>
          <div class="flex flex-col gap-5">
            <div class="flex items-baseline justify-between border-b pb-4" style="border-color: rgba(246,238,232,0.12)">
              <span class="font-serif text-5xl" style="color: var(--color-papel)">10</span>
              <span class="text-sm" style="color: rgba(246,238,232,0.65)">semestres</span>
            </div>
            <div class="flex items-baseline justify-between border-b pb-4" style="border-color: rgba(246,238,232,0.12)">
              <span class="font-serif text-5xl" style="color: var(--color-papel)">165</span>
              <span class="text-sm" style="color: rgba(246,238,232,0.65)">créditos</span>
            </div>
            <div class="flex items-baseline justify-between">
              <span class="font-serif text-5xl texto-grad">39</span>
              <span class="text-sm" style="color: rgba(246,238,232,0.65)">asignaturas</span>
            </div>
          </div>
          <a href="/malla/" class="mt-7 inline-flex items-center gap-2 text-[13px] font-semibold link-editorial" style="color: var(--color-unal-verde)">
            Explora la malla interactiva
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M7 17 17 7M7 7h10v10"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2" style="color: rgba(246,238,232,0.45)" aria-hidden="true">
    <span class="text-[10px] font-sans tracking-[0.25em] uppercase">desliza</span>
    <span class="block w-px h-8 overflow-hidden"><span class="block w-px h-4 animate-bounce" style="background: currentColor"></span></span>
  </div>
</section>
