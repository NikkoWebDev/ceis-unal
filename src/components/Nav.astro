---
const { ruta } = Astro.props;
const links = [
  { href: '/', label: 'Inicio', key: 'home' },
  { href: '/malla/', label: 'Malla Interactiva', key: 'malla' },
  { href: '/foro/', label: 'Foro', key: 'foro' },
  { href: '/#contacto', label: 'Contacto', key: 'contacto' },
];
---

<header class="fixed top-3 inset-x-0 z-50 px-3 md:px-5">
  <div class="glass rounded-2xl max-w-[1120px] mx-auto px-5 h-14 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3 group">
      <span class="w-9 h-9 rounded-xl flex items-center justify-center text-[13px] font-bold tracking-tight transition-all duration-300 group-hover:rotate-6 group-hover:scale-105"
        style="background: linear-gradient(135deg, var(--color-unal), var(--color-unal-claro)); color: #fff">CE</span>
      <span class="flex flex-col leading-tight">
        <span class="text-base tracking-wide font-sans" style="color: var(--fg)">CEIS</span>
        <span class="text-[11px] font-serif italic font-normal" style="color: var(--fg-suave)">Ing. de Sistemas · UNAL</span>
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-1 font-sans text-sm" aria-label="principal">
      {links.map((l) => (
        <a href={l.href} class:list={["px-3.5 py-1.5 rounded-full transition-all font-medium",
          ruta === l.key ? 'font-bold' : 'hover:-translate-y-px']}
          style={ruta === l.key
            ? 'background: color-mix(in srgb, var(--acento) 14%, transparent); color: var(--acento)'
            : 'color: var(--fg-suave)'}
          {...(ruta === l.key ? { 'aria-current': 'page' } : {})}>{l.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <button id="theme-toggle" aria-label="Cambiar tema" class="w-9 h-9 rounded-full border flex items-center justify-center cursor-pointer transition-all hover:scale-110"
        style="border-color: var(--linea); color: var(--fg-suave)">
        <svg class="w-4 h-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>
        <svg class="w-4 h-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <button id="menu-toggle" aria-label="Abrir menú" aria-expanded="false" class="md:hidden w-9 h-9 rounded-full border flex items-center justify-center cursor-pointer"
        style="border-color: var(--linea); color: var(--fg-suave)">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>

  <div id="menu-movil" class="md:hidden hidden glass rounded-2xl mt-2 max-w-[1120px] mx-auto overflow-hidden">
    <nav class="px-5 py-4 flex flex-col gap-1 font-sans text-sm" aria-label="móvil">
      {links.map((l) => (
        <a href={l.href} class:list={["px-3 py-2.5 rounded-xl font-medium transition-colors", ruta === l.key && 'font-bold']}
          style={ruta === l.key
            ? 'background: color-mix(in srgb, var(--acento) 14%, transparent); color: var(--acento)'
            : 'color: var(--fg-suave)'}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('theme-toggle')!;
  toggle.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('ceis-theme', dark ? 'dark' : 'light');
  });
  const menu = document.getElementById('menu-movil')!;
  const menuBtn = document.getElementById('menu-toggle')!;
  menuBtn.addEventListener('click', () => {
    const open = menu.classList.toggle('hidden') === false;
    menuBtn.setAttribute('aria-expanded', String(open));
  });
</script>
